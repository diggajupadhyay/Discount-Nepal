# Copy this file to .env and adjust as needed.

# Server
DISCOUNT_NEPAL_HOST=127.0.0.1
DISCOUNT_NEPAL_PORT=8000

# Cache TTL in seconds (default: 120)
DISCOUNT_NEPAL_CACHE_TTL=120

# HTTP request timeout in seconds
DISCOUNT_NEPAL_TIMEOUT=20

# Max retries per request
DISCOUNT_NEPAL_MAX_RETRIES=2

# Concurrent workers for scraping stores
DISCOUNT_NEPAL_WORKERS=8

# Custom User-Agent
DISCOUNT_NEPAL_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36
